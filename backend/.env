# 本地后端配置（本机测试用）
# 数据库：本机 pg-local Postgres（trust 免密，已装 pgvector）
DB_DSN=postgres://postgres@127.0.0.1:5432/ai_toolset?sslmode=disable

# Supabase 占位（本地不依赖，仅满足启动校验）
SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_ANON_KEY=local-anon-key
SUPABASE_SERVICE_KEY=local-service-key

# JWT（本地测试）
JWT_SECRET=local-dev-secret-change-me
JWT_EXPIRE_HOURS=720

# Ollama（本机 OllamaServer 托管，11434 在线）
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_CHAT_MODEL=deepseek-r1:7b

# 文档存储目录
KNOWLEDGE_STORE_DIR=E:/tools20260623/backend/data/knowledge

# LlamaIndex Python RAG 服务（本地未启动，将自动降级到 Go 本地向量化）
RAG_SERVICE_URL=http://127.0.0.1:8001

# 服务监听
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=debug

CORS_ORIGINS=*
LOG_LEVEL=debug
