# ========================================
# Supabase 配置
# ========================================
# Supabase 项目 URL（格式: https://<project-id>.supabase.co）
# 您当前的 ProjectId: osjidnablnorytfzjjgb
SUPABASE_URL=https://osjidnablnorytfzjjgb.supabase.co

# Supabase anon public key（前端可使用）
# 在 Supabase Dashboard > Settings > API 中获取
SUPABASE_ANON_KEY=请替换为您的anon密钥

# Supabase service_role key（仅服务端使用，严禁暴露到前端）
# 在 Supabase Dashboard > Settings > API 中获取
SUPABASE_SERVICE_KEY=请替换为您的service_role密钥

# ========================================
# 服务配置
# ========================================
SERVER_PORT=8080
SERVER_HOST=127.0.0.1
SERVER_MODE=release  # debug / release / test

# ========================================
# JWT 配置
# ========================================
# 强烈建议使用 openssl rand -hex 32 生成强随机密钥
JWT_SECRET=please-replace-with-openssl-rand-hex-32
JWT_EXPIRE_HOURS=720  # 30天

# ========================================
# CORS 配置
# ========================================
# 多个域名用逗号分隔
# 示例: https://your-frontend.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://172.24.249.108:5173

# ========================================
# 日志配置
# ========================================
LOG_LEVEL=info  # debug / info / warn / error
LOG_FILE=logs/app.log

# ========================================
# 本地 AI (Ollama) 配置
# ========================================
# Ollama 服务地址（docker 部署时为 http://ollama:11434）
OLLAMA_URL=http://localhost:11434
# 嵌入模型（向量化）：bge-m3 / bge-small-en
OLLAMA_EMBEDDING_MODEL=bge-m3
# 对话模型：deepseek-r1:7b / deepseek-r1:14b
OLLAMA_CHAT_MODEL=deepseek-r1:7b
# 文档存储目录（原始文件）
KNOWLEDGE_STORE_DIR=./data/knowledge
